# Servidor Local / Provedor OpenAI
ARTEMIS_DEFAULT_PROVIDER=openai
ARTEMIS_DEFAULT_MODEL=openai/ornith-1.5:35b

# URL Base do Servidor Local (Adicionado OPENAI_BASE_URL para compatibilidade)
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_BASE=http://127.0.0.1:11434/v1
OPENAI_API_KEY=local-no-key-needed

ARTEMIS_ACTUATOR_BACKEND=http
ARTEMIS_TOUCH_API_URL=http://127.0.0.1:8001

ADB_HOST=127.0.0.1
ADB_PORT=5037
ANDROID_SERIAL=
ADB_DEVICE_SERIAL=
ROBOT_IP=192.168.155.1

# Execution Defaults
ARTEMIS_DEFAULT_PROFILE=pro
ARTEMIS_TRACES_DIR=./traces

# Vision-Only Mode (Desativado para injetar a árvore XML da UI)
VISION_ONLY_MODE=true


# Device Driver Subsystem
#DEVICE_DRIVER_MODE=adb_api
#ADB_API_URL=http://localhost:8000

ROBOT_API_URL=http://127.0.0.1:8010