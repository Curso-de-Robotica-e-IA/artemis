# ARTEMIS settings for this project. Copy to .env (do not commit .env) and set at least one key.

# LLM provider keys (ARTEMIS uses Google Gemini by default)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPEN_ROUTER_API_KEY=
# XAI_API_KEY=

# ADB server (default 127.0.0.1:5037)
# ADB_HOST=127.0.0.1
# ADB_PORT=5037

# Ollama settings (if using Ollama as the LLM provider)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Keep the screen on during tasks. It sets stay_on_while_plugged_in=2 and does not restore it,
# so set false if your tests need that setting unchanged.
# ARTEMIS_KEEP_DEVICE_AWAKE=true

# Let ARTEMIS install its Accessibility Helper app on the phone (false = UIAutomator2 only)
# ARTEMIS_HELPER_AUTO_INSTALL=true

# Where task traces are saved (default: ./traces)
# ARTEMIS_TRACES_DIR=
