{
  // ==============================================================================
  // ☕ ARTEMIS Autonomous Agent & Framework Configuration
  // ==============================================================================
  // ------------------------------------------------------------------------------
  // 1. Global Default Model (Applied to all sub-agents unless overridden below)
  // ------------------------------------------------------------------------------
  "default": {
    "provider": "openai",
    "model": "qwen3.8:27b",
    "thinking_level": "medium",
    "fallback": {
      "provider": "openai",
      "model": "qwen3.8:27b",
      "thinking_level": "medium"
    }
  },
  // ------------------------------------------------------------------------------
  // 2. Ready-to-Use Presets (Switch easily in code or CLI)
  // ------------------------------------------------------------------------------
  "presets": {
    "local-ollama": {
      "provider": "openai",
      "model": "ornith-1.5:35b",
      "fallback": {
        "provider": "openai",
        "model": "ornith-1.5:35b"
        
      }
    },
    "google-gemini": {
      "provider": "google",
      "model": "gemini-3.8-flash",
      "thinking_level": "medium",
      "fallback": {
        "provider": "google",
        "model": "gemini-3.7-flash",
        "thinking_level": "medium"
      }
    }
  },
  // ------------------------------------------------------------------------------
