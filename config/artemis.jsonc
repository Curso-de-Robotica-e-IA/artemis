{
  // ==============================================================================
  // ☕ ARTEMIS Autonomous Agent & Framework Configuration
  // ==============================================================================
  // ------------------------------------------------------------------------------
  // 1. Global Default Model (Applied to all sub-agents unless overridden below)
  // ------------------------------------------------------------------------------
  "default": {
    "provider": "openai",
    "model": "ornith-1.5:35b",
    "timeout": 900.0,
    "thinking_level": "medium",
    "fallback": {
      "provider": "openai",
      "model": "qwen3.8:27b",
      "timeout": 900.0,
      "thinking_level": "medium"
    }
  },
  // ------------------------------------------------------------------------------
  // 2. Ready-to-Use Presets (Switch easily in code or CLI)
  // ------------------------------------------------------------------------------
  "presets": {
    "local-ollama": {
      "provider": "openai",
      "model": "ornith-1.5:35b",
      "timeout": 900.0,
      "fallback": {
        "provider": "openai",
        "model": "qwen3.8:27b",
        "timeout": 900.0
      }
    }
  },
  // ------------------------------------------------------------------------------
  // 3. Agent & Sub-Agent Node Customizations (Optional - Inherits from 'default')
  // ------------------------------------------------------------------------------
  "nodes": {
    "provider": "openai",
    // 🧠 Planner: High-level goal decomposition and strategic step planning
    "planner": {
      "model": "ornith-1.5:35b",
      "thinking_level": "high"
    },
    // 🎯 Operator: Screen perception, element interaction, and direct execution
    "operator": {
      "model": "ornith-1.5:35b",
      "thinking_level": "medium",
      "include_thoughts": true
    },
    // 🎬 Video Analyzer: Multimodal screen recording verification and temporal analysis
    "video_analyzer": {
      "model": "ornith-1.5:35b"
    },
    // 👁️ Object Detector & Explorer (Flash Mode): Visual coordinates grounding and bounding boxes
    "object_detector": {
      "model": "ornith-1.5:35b",
      "timeout": 900.0,
      "fallback": {
        "provider": "openai",
        "model": "ornith-1.5:35b",
        "timeout": 900.0
      }
    },
    // 🔍 Explorer: Deep element grounding and multi-candidate visual search
    "explorer": {
      "model": "ornith-1.5:35b",
      "thinking_level": "medium"
    },
    // 📋 Summarizer: Aggregates step history and generates structured outcome
    "summarizer": {
      "model": "ornith-1.5:35b"
    },
    // 🔽 Hopper: Fast lightweight package name locator
    "hopper": {
      "model": "ornith-1.5:35b",
      "timeout": 900.0,
      "fallback": {
        "provider": "openai",
        "model": "lfm2.5:24b",
        "timeout": 900.0
      }
    },
    // 📝 Outputter: Synthesizes execution trace into final output report
    "outputter": {
      "model": "ornith-1.5:35b"
    },
    // 🪵 Log Analyzer: Error log diagnosis with search grounding
    "log_analyzer": {
      "model": "ornith-1.5:35b",
      "enable_grounding": true
    },
    // 🩺 Diagnoser Expert: Failure root cause diagnosis with search grounding
    "diagnoser_expert": {
      "model": "ornith-1.5:35b",
      "enable_grounding": true
    },
    // 🏛️ Committee Council Members
    "planner_avatar": {
      "model": "ornith-1.5:35b"
    },
    "history_analyzer_expert": {
      "model": "ornith-1.5:35b"
    },
    // 🔎 Checker: Plan-declared checkpoint verification and exit final review.
    "checker": {
      "model": "ornith-1.5:35b",
      "thinking_level": "medium",
      "include_thoughts": true
    }
  },
  // ------------------------------------------------------------------------------
  // 4. Runtime Mode & Agent Capabilities Configuration (Dual-Engine: Flash vs. Pro)
  // ------------------------------------------------------------------------------
  "agent": {
    "flash": {
      "max_turns": 0,
      "explorer_mode": "flash",
      // 🧠 Step Summarizer: Asynchronous visual context compressor
      "step_summarizer": {
        "enabled": true,
        "model": "ornith-1.5:35b",
        "timeout": 900.0,
        "prune_history_xml": true
      }
    },
    "pro": {
      "explorer": {
        "mode": "flash"
      },
      "planner_validation": {
        "enabled": true
      },
      "committee": {
        "enabled": false,
        "debate_rounds": 2
      },
      "checker": {
        "enabled": true,
        "midway_checks": false,
        "final_check": true,
        "max_iterations": 20,
        "final_check_max_attempts": 3,
        "checkpoint_max_repairs": 2,
        "max_concurrent_checkpoints": 3,
        "checkpoint_timeout": 180.0,
        "settlement_timeout": 120.0,
        "assert_failure_policy": "continue",
        "device_probes": true
      },
      "video_analyzer": {
        "enabled": true,
        "enable_ledger": true
      }
    },
    "memory": {
      "runtime": {
        "max_concurrency": 2,
        "retry_limit": 3,
        "flush_timeout_s": 30
      },
      "transcript": {
        "enabled": true,
        // Caso observe pressão excessiva de memória unificada no Jetson,
        // reduza context_budget_tokens para 32000.
        "context_budget_tokens": 32000,
        "start_ratio": 0.35,
        "soft_ratio": 0.7,
        "hard_ratio": 0.9,
        "min_active_steps": 5,
        "image_scrub_depth": 3,
        "image_scrub_depth_relaxed": 6,
        "pending_grace_steps": 3,
        "xml_scrub_depth": 1,
        "similarity_hint": true,
        "similarity_max_distance": 5
      },
      "chunking": {
        "max_steps": 12,
        "min_steps": 3,
        "target_source_tokens": 2000,
        "model": "ornith-1.5:35b",
        "timeout": 900.0,
        "max_chunks": 8
      },
      "recall": {
        "enabled": true,
        "max_results": 5,
        "max_text_tokens": 2000,
        "screen_scan_steps": 150
      },
      "replay": {
        "max_steps": 5,
        "max_tokens": 12000
      }
    },
    "video_analyzer": {
      "enabled": true,
      "enable_ledger": true
    },
    "outputter": {
      "enabled": true,
      "force_synthesis": false
    },
    "explorer": {
      "default_version": "flash"
    },
    "explorer_versions": {},
    "denylisted_tools": {
      "explorer": []
    }
  }
}