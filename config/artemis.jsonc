  // ------------------------------------------------------------------------------
  // 4. Runtime Mode & Agent Capabilities Configuration (Dual-Engine: Flash vs. Pro)
  // ------------------------------------------------------------------------------
  "agent": {
    "flash": {
      "max_turns": 0,
      "explorer_mode": "flash",
      "step_summarizer": {
        "enabled": false,
        "model": "ornith-1.5:35b",
        "prune_history_xml": true
      }
    },
    "pro": {
      "explorer": {
        "enabled": false,
        "mode": "flash"
      },
      "planner_validation": {
        "enabled": false
      },
      "committee": {
        "enabled": false,
        "debate_rounds": 1
      },
      "checker": {
        "enabled": false,
        "midway_checks": false,
        "final_check": true,
        "max_iterations": 5,
        "final_check_max_attempts": 1,
        "checkpoint_max_repairs": 1,
        "max_concurrent_checkpoints": 1,
        "checkpoint_timeout": 60.0,
        "settlement_timeout": 60.0,
        "assert_failure_policy": "continue",
        "device_probes": false
      },
      "video_analyzer": {
        "enabled": false,
        "enable_ledger": false
      }
    },
    "memory": {
      "runtime": {
        "max_concurrency": 1,
        "retry_limit": 2,
        "flush_timeout_s": 15
      },
      "transcript": {
        "enabled": true,
        "context_budget_tokens": 24000,
        "start_ratio": 0.35,
        "soft_ratio": 0.7,
        "hard_ratio": 0.9,
        "min_active_steps": 3,
        "image_scrub_depth": 1,
        "image_scrub_depth_relaxed": 2,
        "pending_grace_steps": 1,
        "xml_scrub_depth": 1,
        "similarity_hint": true,
        "similarity_max_distance": 5
      },
      "chunking": {
        "max_steps": 15,
        "min_steps": 6,
        "target_source_tokens": 1500,
        "model": "ornith-1.5:35b",
        "max_chunks": 4
      },
      "recall": {
        "enabled": false,
        "max_results": 2,
        "max_text_tokens": 1000,
        "screen_scan_steps": 50
      },
      "replay": {
        "max_steps": 2,
        "max_tokens": 4000
      }
    },
    "video_analyzer": {
      "enabled": false,
      "enable_ledger": false
    },
    "outputter": {
      "enabled": false,
      "force_synthesis": false
    },
    "explorer": {
      "enabled": false,
      "default_version": "flash"
    },
    "explorer_versions": {},
    "denylisted_tools": {
      "operator": ["ask_explorer", "video_analyzer", "ask_diagnoser"],
      "flash": ["ask_explorer", "video_analyzer"],
      "explorer": []
    }
  }
}