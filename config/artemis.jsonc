{
  // ==============================================================================
  // ☕ ARTEMIS Autonomous Agent & Framework Configuration
  // ==============================================================================

  // ------------------------------------------------------------------------------
  // 1. Global Default Model (Applied to all sub-agents unless overridden below)
  // ------------------------------------------------------------------------------
  "default": {
    "provider": "ollama",
    "model": "ornith-1.5:35b",
    "thinking_level": "medium",
    "fallback": {
      "provider": "openai",
      "model": "ornith-1.5:35b",
      "thinking_level": "medium"
    }
  },

  // ------------------------------------------------------------------------------
  // 2. Ready-to-Use Presets (Switch easily in code or CLI)
  // ------------------------------------------------------------------------------
  "presets": {
    "gemini-flagship": {
      "provider": "google",
      "model": "gemini-3.8-flash",
      "fallback": { "provider": "google", "model": "gemini-3.7-flash" }
    },
    "gemini-flash": {
      "provider": "google",
      "model": "gemini-2.5-flash",
      "fallback": { "provider": "google", "model": "gemini-2.0-flash" }
    },
    "openai-gpt4o": {
      "provider": "openai",
      "model": "gpt-4o",
      "fallback": { "provider": "openai", "model": "gpt-4o-mini" }
    },
    "cost-saving": {
      "provider": "google",
      "model": "gemini-3.5-flash-lite",
      "fallback": { "provider": "google", "model": "gemini-3.1-flash-lite" }
    },
    "local-ollama": {
      "provider": "openai",
      "model": "ornith-1.5:35b",
      "fallback": {
        "provider": "openai",
        "model": "ornith-1.5:35b"
      }
    }
  },

  // ------------------------------------------------------------------------------
