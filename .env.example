# ==============================================================================
# Artemis Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# LLM Providers (Configure at least one)
#GEMINI_API_KEY=
#GOOGLE_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#OPEN_ROUTER_API_KEY=
#XAI_API_KEY=

# For local deployment of Ollama, set the base URL to your local server
#OPENAI_API_KEY=ollama
#OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Google Cloud Vision OCR (Optional - for advanced OCR processing)
#OCR_API_KEY=

# Android ADB Connectivity (Optional - defaults to 127.0.0.1:5037)
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=
# Keep the display awake, falling back to a wake lock or safe heartbeat when needed.
# Set to false if Artemis is used with a personal device whose screen should time out.
ARTEMIS_KEEP_DEVICE_AWAKE=true
# UI hierarchy backend: auto (Accessibility Helper, UIAutomator2 fallback) | helper | uiautomator
ARTEMIS_HIERARCHY_BACKEND=auto
# Let tasks install / upgrade the Accessibility Helper APK on a device they hold.
# Set to false on shared or personal phones: then only `artemis helper install` installs it.
ARTEMIS_HELPER_AUTO_INSTALL=true

# Artemis Execution Defaults (flash or pro)
ARTEMIS_DEFAULT_PROFILE=flash

# Task timeout in seconds (e.g. 1200 for 20 min, or 0 / unlimited to disable timeout)
ARTEMIS_TASK_TIMEOUT=1200

# Maximum dimension in pixels for screenshots sent to LLM (e.g. 1280 for fast vision prefill, 0 to disable)
ARTEMIS_IMAGE_MAX_DIM=1280

# UI Hierarchy & Minimal List Optimization (false disables verbose occlusion warnings)
ARTEMIS_UI_OCCLUSION_WARNINGS=false

# Settling delay in milliseconds before capturing screen (default: 150ms for responsive local execution)
ARTEMIS_SETTLE_MS=150

# Background visual step summarizer (false avoids GPU contention when running Ollama locally)
ARTEMIS_STEP_SUMMARIZER=false
